{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio",
      // Replace with the id printed by `pnpm exec wrangler d1 create portfolio` before the first remote deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Browser origins allowed to call the API (CORS). Add your Pages domain(s) here.
    "ALLOWED_ORIGINS": "http://localhost:4200,https://kurath.dev,https://www.kurath.dev"
  },
  // `ng serve` proxies /api to localhost:8080 (proxy.conf.json), so the local API listens there.
  "dev": { "port": 8080 }
}
