{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio",
			// Id printed by `pnpm exec wrangler d1 create portfolio`.
			"database_id": "83bc54e5-3387-42ba-bba8-f761afaf4e5a",
			"migrations_dir": "migrations"
		}
	],
	// Uploaded images (project banners, portrait). Create once: `pnpm exec wrangler r2 bucket create portfolio-images`.
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "portfolio-images"
		}
	],
	"vars": {
		// Browser origins allowed to call the API (CORS). Add your Pages domain(s) here.
		"ALLOWED_ORIGINS": "http://localhost:4200,https://mitjakurath.ch,https://portfolio-76o.pages.dev",
		// Contact form email notification (sender must be on a domain verified at Resend).
		"CONTACT_TO_EMAIL": "",
		"CONTACT_FROM_EMAIL": "",
		// Admin API (Cloudflare Access). See api/README.md → Admin panel.
		"ACCESS_TEAM_DOMAIN": "https://portfolio-76o-pages.cloudflareaccess.com",
		"ACCESS_AUD": "1f461c98162b0012d58f5b194ef36b1d8cc9dfe1e0849f78f7e85622b87b6496",
		"ADMIN_EMAILS": "mitja.kurath@mitjakurath.ch"
	},
	// Secrets (not in this file): TURNSTILE_SECRET_KEY, RESEND_API_KEY, DEPLOY_HOOK_URL.
	// Production: `pnpm exec wrangler secret put <NAME>`. Local: api/.dev.vars (see .dev.vars.example).
	"ratelimits": [
		// At most 5 contact form posts per IP per minute.
		{
			"name": "CONTACT_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	// Serve the API on the site's own domain: same origin for the site, and Cloudflare Access
	// can protect /api/v1/admin together with /admin.
	"routes": [{ "pattern": "mitjakurath.ch/api/*", "zone_name": "mitjakurath.ch" }],
	// `ng serve` proxies /api to localhost:8080 (proxy.conf.json), so the local API listens there.
	// `host`: keep request URLs on localhost in `wrangler dev` (otherwise they take the route's
	// host, which turns off the localhost-only admin bypass and yields production image URLs).
	"dev": {
		"port": 8080,
		"host": "localhost:8080"
	}
}