# Copy to .dev.vars for `pnpm dev`. Cloudflare's official Turnstile *test* secret: it accepts
# tokens from the test site keys, e.g. 1x00000000000000000000BB (invisible, always passes).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional: email notifications via Resend.
# RESEND_API_KEY=re_...
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Portfolio <contact@your-domain.dev>

# Local admin without Cloudflare Access (only works for requests to localhost).
ADMIN_DEV_BYPASS=true
